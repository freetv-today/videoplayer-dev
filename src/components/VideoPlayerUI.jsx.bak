import { useState, useEffect, useRef } from 'preact/hooks';
import videojs from 'video.js';
import 'video.js/dist/video-js.css';
import '@videojs/themes/dist/fantasy/index.css';
import 'videojs-playlist';
import { playlistVisibilitySignal } from '@signals/playlistVisibility';
import { useVideoResume } from '@hooks/useVideoResume';

/**
 * VideoPlayerUI - Pure UI component for video playback
 * 
 * This component is UI-only and receives clean, processed data as props.
 * It handles VideoJS initialization, resume functionality, and playlist display.
 * Data fetching and processing is handled by VideoLoader component.
 * 
 * @param {Object} props - Component props
 * @param {Array} props.playlist - Array of video objects with sources, title, etc.
 * @param {string} props.identifier - Internet Archive identifier for resume functionality
 * @param {Object} [props.metadata] - Metadata about the playlist (total items, formats, etc.)
 * @param {function} [props.onTrack] - Callback for analytics tracking (event, identifier, data)
 * @param {function} [props.onLoadMore] - Callback to load more videos (fromIndex, toIndex)
 * 
 * @returns {import('preact').JSX.Element} The VideoPlayerUI component
 */

const VideoPlayerUI = ({ 
  playlist = [], 
  identifier, 
  metadata = {}, 
  onTrack,
  onLoadMore 
}) => {
  const videoRef = useRef(null);
  const [player, setPlayer] = useState(null);
  const progressPoints = [0.25, 0.5, 0.75]; // For tracking milestones

  // Use custom hook for resume functionality
  const { showResume, savedTime, handleResume } = useVideoResume(player, identifier);

  console.log(`🎮 VideoPlayerUI: Initialized for ${identifier} with ${playlist.length} videos`);
  if (metadata.totalItems) {
    console.log(`📊 VideoPlayerUI: Total available: ${metadata.totalItems} videos`);
  }

    // Show nav buttons when player is ready
    useEffect(() => {
      if (playlist && playlist.length > 0) {
        // Show navigation buttons immediately
        import('@signals/showVidNavBtns').then(mod => {
          mod.showVidNavBtnsSignal.value = true;
        });
      }
    }, [playlist]);

  // Initialize VideoJS player when playlist is ready
  useEffect(() => {
    if (!videoRef.current || !playlist.length) return;

    console.log(`🎬 VideoPlayerUI: Initializing VideoJS player with ${playlist.length} videos`);

    const vjsPlayer = videojs(videoRef.current, {
      fluid: false,
      responsive: false,
      fill: true,
      playbackRates: [0.5, 1, 1.25, 1.5, 2]
    });

    // @ts-ignore - playlist method added by videojs-playlist plugin
    vjsPlayer.playlist(playlist);

    setPlayer(vjsPlayer);

    console.log(`✅ VideoPlayerUI: VideoJS player initialized successfully`);

    // Tracking: Events for analytics
    vjsPlayer.on('play', () => {
      console.log(`▶️ VideoPlayerUI: Play event for ${identifier}`);
      if (onTrack) onTrack('play', identifier);
    });

    vjsPlayer.on('ended', () => {
      console.log(`🏁 VideoPlayerUI: Video ended for ${identifier}`);
      if (onTrack) onTrack('complete', identifier);
    });

    // Debounced progress tracking for milestones
    let lastProgress = 0;
    const trackProgress = () => {
      const current = vjsPlayer.currentTime() / vjsPlayer.duration();
      const nextPoint = progressPoints.find(p => p > lastProgress && current >= p);
      if (nextPoint) {
        lastProgress = nextPoint;
        console.log(`📊 VideoPlayerUI: Progress milestone ${Math.round(nextPoint * 100)}% for ${identifier}`);
        if (onTrack) onTrack('progress', identifier, Math.round(nextPoint * 100));
      }
    };
    vjsPlayer.on('timeupdate', trackProgress);

    // Cleanup function
    return () => {
      console.log(`🧹 VideoPlayerUI: Cleaning up VideoJS player for ${identifier}`);
      vjsPlayer.off('play');
      vjsPlayer.off('ended');
      vjsPlayer.off('timeupdate', trackProgress);
    };
  }, [playlist, identifier, onTrack]);

  // Cleanup player on unmount
  useEffect(() => {
    return () => {
      if (player) {
        console.log(`🗑️ VideoPlayerUI: Disposing VideoJS player for ${identifier}`);
        player.dispose();
      }
    };
  }, [player, identifier]);

  // Handle playlist item click
  const handlePlaylistItemClick = (item, idx) => {
    if (!player) return;

    console.log(`🎬 VideoPlayerUI: Playing video ${idx + 1}/${playlist.length}:`, {
      title: item.title,
      source: item.sources[0].src,
      format: item.originalFormat,
      fileName: item.fileName
    });

    player.src(item.sources);
    player.load();
    player.play();
    document.title = item.title;

    // Check if we need to load more items (lazy loading)
    if (onLoadMore && metadata.totalItems && (idx + 5) >= playlist.length && playlist.length < metadata.totalItems) {
      console.log(`📦 VideoPlayerUI: Near end of playlist, requesting more videos`);
      onLoadMore(playlist.length + 1, playlist.length + 10);
    }
  };

  // Empty playlist state
  if (!playlist || playlist.length === 0) {
    return (
      <div className="container text-center my-5 p-4">
        <h2 className="text-warning mb-4">📹 No Videos Loaded</h2>
        <p>No video data was provided to the player.</p>
        {metadata.identifier && (
          <p className="text-secondary">
            Check the <a 
              href={`https://archive.org/details/${metadata.identifier}`} 
              target="_blank" 
              rel="noopener noreferrer"
              className="link-primary"
            >
              Internet Archive page
            </a> for more details.
          </p>
        )}
      </div>
    );
  }

  return (
    <>
      {/* VideoJS Player */}
      <div className="custom-ia-player">
        <div className="video-wrapper" data-vjs-player>
          <video
            id="vidplayer"
            ref={videoRef}
            className="video-js vjs-big-play-centered fantasy-skin"
            controls
            preload="auto"
            data-setup="{}"
          >
            {/* Video sources loaded dynamically by VideoJS */}
          </video>
          
          {/* Resume overlay */}
          {showResume && (
            <div className="overlay-resume">
              <div className="overlay-content">
                <p>Resume from {Math.round(savedTime / 60)} min?</p>
                <button onClick={() => handleResume(true)}>Yes</button>
                <button onClick={() => handleResume(false)}>Start Over</button>
              </div>
            </div>
          )}
        </div>
        
        {/* Playlist */}
        <div className={`playlist-wrapper ${playlistVisibilitySignal.value ? '' : 'playlist-hidden'}`}>
          <div className="playlist-content">

            {/* Playlist header with metadata */}
            {metadata.totalItems && metadata.totalItems > playlist.length && (
              <div className="playlist-header text-center mb-2">
                <small className="text-muted">
                  Showing {playlist.length} of {metadata.totalItems} videos
                  {metadata.cached && (
                    <span className="ms-2 badge bg-success">Cached</span>
                  )}
                </small>
              </div>
            )}
            
            <ul className="playlist-list">
              {playlist.map((item, idx) => (
                <li 
                  key={idx} 
                  onClick={() => handlePlaylistItemClick(item, idx)}
                  title={`Format: ${item.originalFormat || 'Unknown'} | File: ${item.fileName || item.title}`}
                >
                  <span>{item.title}</span>
                </li>
              ))}
            </ul>
            
            {/* Load more button for lazy loading */}
            {onLoadMore && metadata.totalItems && playlist.length < metadata.totalItems && (
              <div className="playlist-footer text-center mt-2">
                <button 
                  className="btn btn-sm btn-outline-primary"
                  onClick={() => onLoadMore(playlist.length + 1, playlist.length + 10)}
                >
                  Load More Videos ({metadata.totalItems - playlist.length} remaining)
                </button>
              </div>
            )}
          </div>
        </div>
      </div>
    </>
  );
};

export default VideoPlayerUI;